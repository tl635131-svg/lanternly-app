# ── digital-invite web (Next.js) ─────────────────────────────────────────────────────────────
# Copy to .env.local for local overrides. No secrets live here: the browser only talks to this
# site, and /api/* is forwarded server-side to the API.

# Where /api/* is forwarded (read at request time, so one build works anywhere).
# Accepts a full URL or a bare host:port (Render's `fromService … property: hostport`).
#   local dev:            http://localhost:4000
#   Render private net:   digital-invite-api:10000   (or http://digital-invite-api:10000)
#   public API URL:       https://digital-invite-api.onrender.com
# INTERNAL_API_URL and the older API_URL are accepted as aliases.
API_ORIGIN=http://localhost:4000

# Public address of this site, for absolute URLs (Open Graph metadata). Optional: on Render it
# falls back to RENDER_EXTERNAL_URL, and otherwise to the request's own host.
# NEXT_PUBLIC_SITE_URL is accepted as an alias.
PUBLIC_BASE_URL=

# Port and bind address for `npm start` (Render sets PORT; the start script binds 0.0.0.0).
# PORT=3000

# Optional: build into another folder (e.g. to test a production build while `next dev` uses .next).
# NEXT_DIST_DIR=.next-build

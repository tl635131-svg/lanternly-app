// Digital invitation platform — original schema (Backend Builder).
// Postgres is the target. Tables/columns are snake_case in the DB, camelCase in code.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── enums ─────────────
enum UserRole {
  host
  staff
  admin
}

enum MemberRole {
  owner
  cohost
  viewer
}

enum ProductType {
  wedding_invite
  save_the_date
  birthday
  bridesmaid
}

enum PlanCode {
  diy
  std
  experience
  premium
  birthday
  bridesmaid
}

enum ServiceMode {
  self_serve
  studio
}

enum OrderStatus {
  draft
  pending_payment
  paid
  refunded
  canceled
}

enum ProductionStage {
  order_received
  brief_received
  in_queue
  designing
  review
  delivered
}

enum BriefStatus {
  not_started
  in_progress
  submitted
  archived
}

enum RevisionStatus {
  submitted
  in_progress
  completed
}

enum InvitationStatus {
  draft
  preview
  published
  archived
}

enum Attendance {
  yes
  no
  pending
}

enum PartyMemberType {
  adult
  child
}

enum InviteeStatus {
  not_sent
  sent
  opened
  responded
  bounced
  opted_out
}

enum Channel {
  email
  sms
  whatsapp
  link
  qr
}

enum MessageStatus {
  queued
  sending
  sent
  delivered
  failed
  bounced
  opened
}

enum JobStatus {
  scheduled
  running
  done
  failed
  canceled
}

enum TableShape {
  round
  rect
  square
  u_shape
  serpentine
  head
}

enum TokenPurpose {
  set_password
  reset_password
  login
  cohost_invite
}

// ───────────── accounts ─────────────
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique // always stored lower-cased
  passwordHash     String?   @map("password_hash") // argon2id; null until set via one-time link
  name             String?
  role             UserRole  @default(host)
  locale           String    @default("en")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  lastLoginAt      DateTime? @map("last_login_at")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  disabledAt       DateTime? @map("disabled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  tokens         AuthToken[]
  memberships    EventMember[]             @relation("member")
  orders         Order[]
  manualOrders   Order[]                   @relation("manualOrders")
  assignedEvents Event[]                   @relation("assignedStaff")
  revisions      Revision[]
  comments       RevisionComment[]
  assets         Asset[]
  musicRights    MusicRightsConfirmation[]

  @@map("users")
}

model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @map("user_id") @db.Uuid
  email     String
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") // sha256 of the raw token; raw token is only ever in the email link
  eventId   String?      @map("event_id") @db.Uuid
  data      Json?
  expiresAt DateTime     @map("expires_at")
  usedAt    DateTime?    @map("used_at")
  createdAt DateTime     @default(now()) @map("created_at")

  user  User?  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([email, purpose])
  @@map("auth_tokens")
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  csrfToken  String   @map("csrf_token")
  userAgent  String?  @map("user_agent")
  ip         String?
  expiresAt  DateTime @map("expires_at")
  lastSeenAt DateTime @default(now()) @map("last_seen_at")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ───────────── catalogue ─────────────
model Plan {
  code                 PlanCode    @id
  product              ProductType
  serviceMode          ServiceMode @map("service_mode")
  nameI18n             Json        @map("name_i18n")
  descriptionI18n      Json        @map("description_i18n")
  features             Json        @default("[]") // array of { en: "..." }
  basePriceCents       Int         @map("base_price_cents")
  currency             String      @default("CAD") @db.Char(3)
  includedBlocks       Int?        @map("included_blocks") // null = unlimited
  extraBlockPriceCents Int         @default(0) @map("extra_block_price_cents")
  maxLanguages         Int         @default(1) @map("max_languages")
  revisionRounds       Int         @default(0) @map("revision_rounds") // 99 = unlimited
  deliveryDays         Int?        @map("delivery_days")
  includesAllExtras    Boolean     @default(false) @map("includes_all_extras")
  hasRsvp              Boolean     @default(true) @map("has_rsvp")
  usesSections         Boolean     @default(true) @map("uses_sections")
  active               Boolean     @default(true)
  sort                 Int         @default(0)

  planExtras PlanExtra[]
  orders     Order[]
  events     Event[]

  @@map("plans")
}

model Extra {
  code            String  @id
  nameI18n        Json    @map("name_i18n")
  descriptionI18n Json    @map("description_i18n")
  priceCents      Int?    @map("price_cents")
  currency        String  @default("CAD") @db.Char(3)
  active          Boolean @default(true)
  sort            Int     @default(0)

  planExtras PlanExtra[]

  @@map("extras")
}

model PlanExtra {
  planCode  PlanCode @map("plan_code")
  extraCode String   @map("extra_code")

  plan  Plan  @relation(fields: [planCode], references: [code], onDelete: Cascade)
  extra Extra @relation(fields: [extraCode], references: [code], onDelete: Cascade)

  @@id([planCode, extraCode])
  @@map("plan_extras")
}

model Theme {
  id              String        @id @default(uuid()) @db.Uuid
  key             String        @unique
  products        ProductType[] @default([wedding_invite, save_the_date, birthday, bridesmaid]) // products this design can be used for
  nameI18n        Json          @map("name_i18n")
  descriptionI18n Json          @map("description_i18n")
  moodTags        String[]      @map("mood_tags")
  previewVideoUrl String?       @map("preview_video_url")
  posterUrl       String?       @map("poster_url")
  demoSlug        String?       @map("demo_slug")
  isNew           Boolean       @default(false) @map("is_new")
  isPopular       Boolean       @default(false) @map("is_popular")
  status          String        @default("active") // active | coming_soon | retired
  defaultConfig   Json          @default("{}") @map("default_config")
  sort            Int           @default(0)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  orders      Order[]
  invitations Invitation[]

  @@map("themes")
}

model MusicTrack {
  id        String   @id @default(uuid()) @db.Uuid
  title     String
  artist    String
  license   String
  url       String?
  durationS Int      @map("duration_s")
  moodTags  String[] @map("mood_tags")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("music_tracks")
}

// ───────────── checkout & orders ─────────────
model CheckoutDraft {
  id               String    @id @db.Uuid // client-generated
  planCode         PlanCode? @map("plan_code")
  lastStep         String?   @map("last_step")
  themeKey         String?   @map("theme_key")
  sections         String[]
  extras           String[]
  languages        String[]
  info             Json?
  email            String?
  vision           String?
  utm              Json?
  abandoned        Boolean   @default(false)
  convertedOrderId String?   @map("converted_order_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([updatedAt])
  @@index([email])
  @@map("checkout_drafts")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  number            String      @unique
  userId            String?     @map("user_id") @db.Uuid
  eventId           String?     @map("event_id") @db.Uuid
  email             String
  planCode          PlanCode?   @map("plan_code") // null for add-on-only orders (kind = addons)
  themeId           String?     @map("theme_id") @db.Uuid
  sections          String[]
  extras            String[]
  languages         String[]
  vision            String?
  buyerInfo         Json        @map("buyer_info")
  subtotalCents     Int         @map("subtotal_cents")
  discountCents     Int         @default(0) @map("discount_cents")
  taxCents          Int         @default(0) @map("tax_cents")
  totalCents        Int         @map("total_cents")
  currency          String      @default("CAD") @db.Char(3)
  status            OrderStatus @default(pending_payment)
  paymentProvider   String      @map("payment_provider") // mock | stripe | manual (admin sale)
  checkoutSessionId String?     @unique @map("checkout_session_id")
  checkoutUrl       String?     @map("checkout_url")
  paymentIntentId   String?     @map("payment_intent_id")
  paidAt            DateTime?   @map("paid_at")
  refundedAt        DateTime?   @map("refunded_at")
  canceledAt        DateTime?   @map("canceled_at")
  consentTermsAt    DateTime    @map("consent_terms_at")
  consentPrivacyAt  DateTime    @map("consent_privacy_at")
  checkoutDraftId   String?     @map("checkout_draft_id") @db.Uuid
  express           Boolean     @default(false)
  kind              String      @default("plan") // plan | addons (add-on-only purchase for a paid event)
  createdByAdminId  String?     @map("created_by_admin_id") @db.Uuid // manual sales (payment_provider = manual)
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdByAdmin User?       @relation("manualOrders", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  event          Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)
  plan           Plan?       @relation(fields: [planCode], references: [code], onDelete: Restrict)
  theme          Theme?      @relation(fields: [themeId], references: [id], onDelete: SetNull)
  items          OrderItem[]

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
  @@index([paymentIntentId])
  @@index([createdByAdminId])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  kind           String // plan | extra | extra_block
  code           String
  label          String
  qty            Int
  unitPriceCents Int    @map("unit_price_cents")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

model ProcessedWebhookEvent {
  id          String   @id // provider event id (idempotency)
  provider    String
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@map("processed_webhook_events")
}

// ───────────── events (tenant root) ─────────────
model Event {
  id                     String          @id @default(uuid()) @db.Uuid
  product                ProductType
  planCode               PlanCode?       @map("plan_code")
  serviceMode            ServiceMode     @map("service_mode")
  title                  String
  hostNames              Json            @map("host_names") // { partner1, partner2 } or { honoree }
  eventDate              DateTime?       @map("event_date") @db.Date
  timezone               String          @default("America/Toronto")
  venueName              String?         @map("venue_name")
  venueAddress           String?         @map("venue_address")
  primaryLanguage        String          @default("en") @map("primary_language")
  languages              String[]        @default(["en"])
  selectedExtras         String[]        @default([]) @map("selected_extras") // self-serve add-ons picked before paying
  productionStage        ProductionStage @default(order_received) @map("production_stage")
  express                Boolean         @default(false)
  maxRevisionRounds      Int             @default(2) @map("max_revision_rounds")
  designApprovedAt       DateTime?       @map("design_approved_at")
  invitesSentManual      Int             @default(0) @map("invites_sent_manual")
  rsvpSettings           Json            @default("{}") @map("rsvp_settings")
  adminNote              String?         @map("admin_note")
  assignedStaffId        String?         @map("assigned_staff_id") @db.Uuid
  highSeasonNotice       Boolean         @default(false) @map("high_season_notice")
  remindersEnabled       Boolean         @default(false) @map("reminders_enabled")
  reminderDaysBefore     Int             @default(7) @map("reminder_days_before")
  notifyOnRsvp           Boolean         @default(true) @map("notify_on_rsvp")
  paidAt                 DateTime?       @map("paid_at")
  deliveredAt            DateTime?       @map("delivered_at")
  archiveAfter           DateTime?       @map("archive_after") @db.Date
  deliveryEmailSentAt    DateTime?       @map("delivery_email_sent_at")
  deliveryEmailSentCount Int             @default(0) @map("delivery_email_sent_count")
  deletionRequestedAt    DateTime?       @map("deletion_requested_at")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  deletedAt              DateTime?       @map("deleted_at")

  plan          Plan?                     @relation(fields: [planCode], references: [code])
  assignedStaff User?                     @relation("assignedStaff", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  members       EventMember[]
  brief         Brief?
  assets        Asset[]
  revisions     Revision[]
  invitations   Invitation[]
  invitees      Invitee[]
  guests        Guest[]
  seatingPlan   SeatingPlan?
  seatingTables SeatingTable[]
  campaigns     Campaign[]
  messages      Message[]
  activity      ActivityLog[]
  orders        Order[]
  tokens        AuthToken[]
  musicRights   MusicRightsConfirmation[]

  @@index([productionStage])
  @@index([eventDate])
  @@index([assignedStaffId])
  @@map("events")
}

model EventMember {
  eventId     String     @map("event_id") @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  role        MemberRole
  invitedById String?    @map("invited_by") @db.Uuid
  createdAt   DateTime   @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation("member", fields: [userId], references: [id], onDelete: Cascade)

  @@id([eventId, userId])
  @@index([userId])
  @@map("event_members")
}

model Brief {
  eventId           String      @id @map("event_id") @db.Uuid
  sections          String[] // ordered keys incl. custom:<slug>
  newSections       String[]    @map("new_sections") // added by studio after submit
  customBlockNames  Json        @default("{}") @map("custom_block_names")
  data              Json        @default("{}")
  status            BriefStatus @default(not_started)
  submittedAt       DateTime?   @map("submitted_at")
  resubmissionCount Int         @default(0) @map("resubmission_count")
  locked            Boolean     @default(false)
  updatedAt         DateTime    @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("briefs")
}

model Asset {
  id           String    @id @default(uuid()) @db.Uuid
  eventId      String    @map("event_id") @db.Uuid
  uploadedById String?   @map("uploaded_by") @db.Uuid
  kind         String // brief_photo | illustration_ref | music | cover | gallery
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  mime         String
  bytes        Int
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  event      Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([eventId, kind])
  @@map("assets")
}

model Revision {
  id          String         @id @default(uuid()) @db.Uuid
  eventId     String         @map("event_id") @db.Uuid
  roundNumber Int            @map("round_number")
  request     String
  status      RevisionStatus @default(submitted)
  staffNote   String?        @map("staff_note")
  createdById String?        @map("created_by") @db.Uuid
  resolvedAt  DateTime?      @map("resolved_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  event     Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  createdBy User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  comments  RevisionComment[]

  @@unique([eventId, roundNumber])
  @@map("revisions")
}

model RevisionComment {
  id         String   @id @default(uuid()) @db.Uuid
  revisionId String   @map("revision_id") @db.Uuid
  authorId   String?  @map("author_id") @db.Uuid
  body       String
  createdAt  DateTime @default(now()) @map("created_at")

  revision Revision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  author   User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([revisionId, createdAt])
  @@map("revision_comments")
}

// ───────────── invitations (theme engine: theme + config + content JSON) ─────────────
model Invitation {
  id               String           @id @default(uuid()) @db.Uuid
  eventId          String           @map("event_id") @db.Uuid
  kind             ProductType
  themeId          String?          @map("theme_id") @db.Uuid
  slug             String           @unique
  customDomain     String?          @unique @map("custom_domain") // reserved for later; not implemented
  status           InvitationStatus @default(draft)
  locale           String           @default("en") // default language for guests
  content          Json             @default("{}") // { "<lang>": { hero, sections: { <key>: {...} } } }
  config           Json             @default("{}") // palette, fonts, cover, music, sectionOrder…
  previewToken     String?          @map("preview_token")
  publishedAt      DateTime?        @map("published_at")
  archivedAt       DateTime?        @map("archived_at")
  version          Int              @default(0) // latest published snapshot (what guests see)
  publishedVersion Int?             @map("published_version") // the invitation_versions.version guests see
  draftChangedAt   DateTime?        @map("draft_changed_at") // last draft save
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  event         Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  theme         Theme?                   @relation(fields: [themeId], references: [id], onDelete: SetNull)
  versions      InvitationVersion[]
  slugRedirects InvitationSlugRedirect[]

  @@index([eventId])
  @@map("invitations")
}

model InvitationVersion {
  id            String   @id @default(uuid()) @db.Uuid
  invitationId  String   @map("invitation_id") @db.Uuid
  version       Int
  themeId       String?  @map("theme_id") @db.Uuid
  content       Json
  config        Json
  publishedById String?  @map("published_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@unique([invitationId, version])
  @@map("invitation_versions")
}

// ───────────── guests ─────────────
// An invitee is a household / party that receives one personal link.
model Invitee {
  id              String        @id @default(uuid()) @db.Uuid
  eventId         String        @map("event_id") @db.Uuid
  householdName   String?       @map("household_name")
  firstName       String        @map("first_name")
  lastName        String?       @map("last_name")
  email           String?
  phoneE164       String?       @map("phone_e164")
  language        String?
  maxPartySize    Int           @default(1) @map("max_party_size")
  knownCompanions Json          @default("[]") @map("known_companions")
  groupLabel      String?       @map("group_label")
  token           String        @unique // url-safe, 128-bit random personal link token
  status          InviteeStatus @default(not_sent)
  sentAt          DateTime?     @map("sent_at")
  lastOpenedAt    DateTime?     @map("last_opened_at")
  openCount       Int           @default(0) @map("open_count")
  respondedAt     DateTime?     @map("responded_at")
  optedOutAt      DateTime?     @map("opted_out_at")
  notes           String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  deletedAt       DateTime?     @map("deleted_at")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guests   Guest[]
  messages Message[]

  @@index([eventId, status])
  @@index([eventId, email])
  @@map("invitees")
}

// A guest row is one RSVP response (a party: main guest + companions).
model Guest {
  id             String     @id @default(uuid()) @db.Uuid
  eventId        String     @map("event_id") @db.Uuid
  inviteeId      String?    @map("invitee_id") @db.Uuid
  fullName       String     @map("full_name")
  email          String?
  phone          String?
  attendance     Attendance
  partySize      Int        @default(1) @map("party_size")
  primaryMeal    String?    @map("primary_meal")
  primaryDietary String?    @map("primary_dietary")
  dietaryTags    String[]   @map("dietary_tags")
  extraEvents    Json       @default("{}") @map("extra_events")
  answers        Json       @default("{}")
  message        String?
  notes          String?
  source         String     @default("rsvp_form") // rsvp_form | manual | import
  language       String?
  editTokenHash  String?    @unique @map("edit_token_hash")
  ipHash         String?    @map("ip_hash")
  userAgent      String?    @map("user_agent")
  submittedAt    DateTime   @default(now()) @map("submitted_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  deletedAt      DateTime?  @map("deleted_at")

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitee     Invitee?         @relation(fields: [inviteeId], references: [id], onDelete: SetNull)
  companions  GuestCompanion[]
  assignments SeatAssignment[]

  @@index([eventId, deletedAt, submittedAt(sort: Desc)])
  @@index([eventId, attendance])
  @@map("guests")
}

model GuestCompanion {
  id       String          @id @default(uuid()) @db.Uuid
  guestId  String          @map("guest_id") @db.Uuid
  type     PartyMemberType
  fullName String          @map("full_name")
  meal     String?
  dietary  String?
  sort     Int             @default(0)

  guest       Guest            @relation(fields: [guestId], references: [id], onDelete: Cascade)
  assignments SeatAssignment[]

  @@map("guest_companions")
}

// ───────────── seating ─────────────
model SeatingPlan {
  eventId   String   @id @map("event_id") @db.Uuid
  layout    Json     @default("[]") // floor elements
  version   Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("seating_plans")
}

model SeatingTable {
  id       String     @id @db.Uuid // client may generate (uuid v4)
  eventId  String     @map("event_id") @db.Uuid
  label    String
  shape    TableShape
  seats    Int
  note     String?
  x        Float      @default(0)
  y        Float      @default(0)
  rotation Float      @default(0)
  sort     Int        @default(0)

  event       Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignments SeatAssignment[]

  @@index([eventId])
  @@map("seating_tables")
}

model SeatAssignment {
  id          String  @id @default(uuid()) @db.Uuid
  tableId     String  @map("table_id") @db.Uuid
  guestId     String? @unique @map("guest_id") @db.Uuid
  companionId String? @unique @map("companion_id") @db.Uuid
  seatIndex   Int?    @map("seat_index")

  table     SeatingTable    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  guest     Guest?          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  companion GuestCompanion? @relation(fields: [companionId], references: [id], onDelete: Cascade)

  @@map("seat_assignments")
}

// ───────────── messaging & jobs ─────────────
model Campaign {
  id          String    @id @default(uuid()) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  kind        String // invite | reminder | update | thank_you
  channel     Channel
  segment     Json      @default("{}")
  templateKey String    @map("template_key")
  subjectI18n Json?     @map("subject_i18n")
  bodyI18n    Json?     @map("body_i18n")
  scheduledAt DateTime  @map("scheduled_at")
  status      JobStatus @default(scheduled)
  stats       Json      @default("{}")
  automatic   Boolean   @default(false)
  createdById String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  event    Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([eventId, createdAt(sort: Desc)])
  @@map("campaigns")
}

model Message {
  id                String        @id @default(uuid()) @db.Uuid
  campaignId        String?       @map("campaign_id") @db.Uuid
  eventId           String?       @map("event_id") @db.Uuid
  inviteeId         String?       @map("invitee_id") @db.Uuid
  userId            String?       @map("user_id") @db.Uuid
  channel           Channel
  toAddress         String        @map("to_address")
  templateKey       String        @map("template_key")
  provider          String?
  providerMessageId String?       @map("provider_message_id")
  status            MessageStatus @default(queued)
  error             String?
  idempotencyKey    String?       @unique @map("idempotency_key")
  sentAt            DateTime?     @map("sent_at")
  deliveredAt       DateTime?     @map("delivered_at")
  openedAt          DateTime?     @map("opened_at")
  createdAt         DateTime      @default(now()) @map("created_at")

  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitee  Invitee?  @relation(fields: [inviteeId], references: [id], onDelete: SetNull)

  @@index([eventId, createdAt(sort: Desc)])
  @@index([status])
  @@map("messages")
}

model Job {
  id          String    @id @default(uuid()) @db.Uuid
  type        String
  payload     Json      @default("{}")
  runAt       DateTime  @default(now()) @map("run_at")
  status      JobStatus @default(scheduled)
  attempts    Int       @default(0)
  maxAttempts Int       @default(4) @map("max_attempts")
  lastError   String?   @map("last_error")
  uniqueKey   String?   @unique @map("unique_key")
  lockedBy    String?   @map("locked_by")
  lockedAt    DateTime? @map("locked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status, runAt])
  @@map("jobs")
}

model ActivityLog {
  id        String   @id @default(uuid()) @db.Uuid
  eventId   String?  @map("event_id") @db.Uuid
  actorType String   @map("actor_type") // guest | host | admin | system
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  data      Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  event Event? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt(sort: Desc)])
  @@map("activity_log")
}

// ───────────── marketing ─────────────
model Review {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String?  @map("order_id") @db.Uuid
  displayName String   @map("display_name")
  location    String?
  text        String
  isSample    Boolean  @default(false) @map("is_sample") // placeholder copy, not a real customer
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([published, createdAt(sort: Desc)])
  @@map("reviews")
}

model ContactMessage {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String
  topic     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

/// Old slugs after a custom_link rename. They keep resolving (301 for pages) and can't be taken by another invitation.
model InvitationSlugRedirect {
  oldSlug      String   @id @map("old_slug")
  invitationId String   @map("invitation_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
  @@map("invitation_slug_redirects")
}

/// One row per "I have the rights to use this music" tick (exactly one of assetId / url).
model MusicRightsConfirmation {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  assetId     String?  @map("asset_id") @db.Uuid
  url         String?
  statement   String
  confirmedAt DateTime @default(now()) @map("confirmed_at")
  ipHash      String?  @map("ip_hash")
  userAgent   String?  @map("user_agent")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("music_rights_confirmations")
}

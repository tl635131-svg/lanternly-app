# ───────────────────────── digital-invite API — example environment ─────────────────────────
# Copy to .env and adjust. NEVER commit real secrets. Values below are placeholders for local dev.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# PostgreSQL (local dev role/database — see README "Database")
DATABASE_URL=postgresql://digital_invite:devpassword@localhost:5432/digital_invite?schema=public

# Public URLs
API_PUBLIC_URL=http://localhost:4000          # used in QR/ics/file/mock-checkout links
WEB_URL=http://localhost:3000                 # front end (auth links: ${WEB_URL}/auth/<token>)
INVITE_BASE_URL=http://localhost:3000/i       # guest invitation links: ${INVITE_BASE_URL}/<slug>?g=<token>
CORS_ORIGINS=http://localhost:3000            # comma-separated allowed origins (credentials enabled)
TRUST_PROXY=false                             # set true behind a reverse proxy / Next.js rewrites so rate limits see the real client IP
FEATURE_OWN_SONG=true                         # own_song add-on (song upload/link + rights tick). false → hidden in the catalogue, own-song paths 403 FEATURE_DISABLED
DEV_ROUTES_ENABLED=true                       # /api/dev/* (mock checkout, admin-only outbox/run-jobs); never in production (startup error)

# Security
APP_SECRET=replace-with-64-random-characters-generated-locally-xxxxxxxxxxxxxxxx   # min 32 chars; signs file URLs, unsubscribe links, cookies
SESSION_TTL_DAYS=30
COOKIE_SECURE=false                           # defaults to true when NODE_ENV=production (required there)
COOKIE_DOMAIN=
SET_PASSWORD_TOKEN_TTL_HOURS=72
RESET_TOKEN_TTL_MINUTES=60
LOGIN_LINK_TTL_MINUTES=20
COHOST_INVITE_TTL_DAYS=7

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_RSVP_PER_MIN=10
RATE_LIMIT_RSVP_PER_HOUR=100
RATE_LIMIT_MULTIPLIER=1                       # scales fixed per-route limits (tests use 100)

# Payments — TEST MODE ONLY. Live keys (sk_live_/rk_live_) are refused at startup.
PAYMENT_DRIVER=auto                           # auto = stripe if STRIPE_SECRET_KEY is set, else mock
STRIPE_SECRET_KEY=                            # sk_test_… from the Stripe dashboard (test mode)
STRIPE_WEBHOOK_SECRET=                        # whsec_… from `stripe listen` or the test-mode webhook endpoint
STRIPE_AUTOMATIC_TAX=true                     # requires Stripe Tax to be enabled on the test account
CURRENCY=CAD

# Email — the console driver NEVER sends; it logs and keeps a dev outbox (GET /api/dev/outbox)
EMAIL_DRIVER=console
EMAIL_FROM=Invitations <hello@example.com>
STUDIO_INBOX=studio@example.com
EMAIL_WEBHOOK_SECRET=                         # shared secret for POST /api/webhooks/email (optional)

# Storage
STORAGE_DRIVER=local                          # local | s3 (s3 driver is a stub interface for now)
STORAGE_LOCAL_DIR=./var/uploads
SIGNED_URL_TTL_SECONDS=604800

# Production demo deploys (Render): mock payments / console email are refused in production unless this is true.
ALLOW_MOCK_PROVIDERS_IN_PRODUCTION=false

# Hosted deploys: the web app's bare hostname fills WEB_URL / INVITE_BASE_URL / CORS_ORIGINS when those are unset.
# API_PUBLIC_URL falls back to RENDER_EXTERNAL_URL (set by Render). Explicit values always win.
WEB_HOST=

# Jobs
RUN_WORKER_IN_PROCESS=true                    # false → run `npm run worker` separately
WORKER_POLL_MS=2000
QUIET_HOURS_ENABLED=true                      # bulk sends wait for 09:00–21:00 in the event's time zone

# Product rules
ARCHIVE_AFTER_MONTHS=2

# Seed (dev only) — passwords for seeded demo accounts; pick your own
SEED_ADMIN_PASSWORD=choose-a-dev-admin-password-1
SEED_DEMO_PASSWORD=choose-a-dev-demo-password-1
# Deploy seed (`npm run start:render` → scripts/seed-if-empty.ts): when the DB has no users, every demo login uses DEMO_PASSWORD (≥12 chars).
DEMO_PASSWORD=

# Seed the three sample testimonials from design/sample-copy.md (flagged isSample). Set false to seed none.
SEED_SAMPLE_REVIEWS=true
